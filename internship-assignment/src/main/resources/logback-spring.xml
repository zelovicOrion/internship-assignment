<configuration>

    <!-- ===================================================== -->
    <!-- Rolling file appender (actual file + rolling policy) -->
    <!-- ===================================================== -->
    <appender name="ROLLING_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Current log file -->
        <file>logs/app.log</file>

        <!-- Log format -->
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

        <!-- Rolling policy: time + size + index + zip -->
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Daily + index + ZIP -->
            <fileNamePattern>
                logs/app-%d{yyyy-MM-dd}.%i.log.zip
            </fileNamePattern>

            <!-- Small size for testing -->
            <maxFileSize>100KB</maxFileSize>

            <!-- Keep last 7 days -->
            <maxHistory>7</maxHistory>

            <!-- Optional: total size cap -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ================================= -->
    <!-- Async appender (IMPORTANT PART)   -->
    <!-- ================================= -->
    <appender name="ASYNC_FILE"
              class="ch.qos.logback.classic.AsyncAppender">

        <!-- Queue size -->
        <queueSize>8192</queueSize>

        <!-- Do NOT drop logs -->
        <discardingThreshold>0</discardingThreshold>

        <!-- Prevent app from blocking -->
        <neverBlock>true</neverBlock>

        <appender-ref ref="ROLLING_FILE"/>
    </appender>

    <!-- ============ -->
    <!-- Root logger  -->
    <!-- ============ -->
    <root level="DEBUG">
        <appender-ref ref="ASYNC_FILE"/>
    </root>

</configuration>